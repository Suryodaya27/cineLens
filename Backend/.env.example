# ===========================================
# CineLens AI — Backend Configuration
# ===========================================
# Copy this file: cp .env.example .env
# Then fill in your API keys below.

# TMDB API (required — cast data and actor images)
# Get free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ImgBB API (required — hosts cropped images)
# Get free key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# SerpAPI (optional — visual product search)
# Get free key at: https://serpapi.com/users/sign_up
# SERPAPI_KEY=your_serpapi_key_here

# PostgreSQL + pgvector (defaults work with the Docker quickstart)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=face_recognition
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Vision model (optional — only used when enable_vision=1)
# VISION_MODEL=qwen3.8:latest

# LLM Replay proxy (optional — for debugging Ollama calls)
# Start replay first: cd ~/Projects/llm-replay && node dist/cli.js ui --session cinelens
# LLM_REPLAY_HOST=http://localhost:11435
